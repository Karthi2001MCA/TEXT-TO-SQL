


# ============================================
# Enterprise AI Data Assistant - Environment Variables
# ============================================

# --- Application ---
APP_NAME="Enterprise AI Data Assistant"
APP_ENV=development
DEBUG=true

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
DATA_DATABASE_URL=sqlite+aiosqlite:///./data/user_data.db

# --- LLM API Keys ---
# Free, no card required:
#   GROQ_API_KEY        console.groq.com/keys
#   OPENROUTER_API_KEY  openrouter.ai/keys          (use ':free' models)
#   GITHUB_MODELS_TOKEN github.com/settings/tokens  (any GitHub account)
#   CEREBRAS_API_KEY    cloud.cerebras.ai
#   MISTRAL_API_KEY     console.mistral.ai
#   GEMINI_API_KEY      aistudio.google.com/apikey  (free tier)
# Paid (require account credit):
#   DEEPSEEK_API_KEY, OPENAI_API_KEY
#
# Leave any of these blank to leave that provider out of the consensus panel.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
GITHUB_MODELS_TOKEN=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# --- Ollama (Local) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- RAG Settings ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_DB_PATH=./data/vector_store
CHUNK_SIZE=500
TOP_K_RESULTS=5

# --- Rate Limiting ---
RATE_LIMIT=100/minute

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- File Upload ---
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./data/uploads
